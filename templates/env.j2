#}

TZ={{ minecraft_environment_variables_tz }}

UID={{ minecraft_uid }}
GID={{ minecraft_gid }}

EULA={{ minecraft_environment_variables_eula }}

{# The port the server binds to inside the container. Without this, changing
   `minecraft_container_tcp_port` would only change the container-side end of the
   `-p` publish mapping, while the server itself kept listening on 25565.
   Declared before the additional variables so that an operator-supplied
   `SERVER_PORT` still wins (with `--env-file`, the last assignment applies). #}
SERVER_PORT={{ minecraft_container_tcp_port }}

{% if minecraft_environment_variables_type != '' %}
TYPE={{ minecraft_environment_variables_type }}
{% endif %}

{% if minecraft_environment_variables_version != '' %}
VERSION={{ minecraft_environment_variables_version }}
{% endif %}

{% if minecraft_environment_variables_max_memory != '' %}
MAX_MEMORY={{ minecraft_environment_variables_max_memory }}
{% endif %}

{% if minecraft_environment_variables_difficulty != '' %}
DIFFICULTY={{ minecraft_environment_variables_difficulty }}
{% endif %}

{% if minecraft_environment_variables_view_distance != '' %}
VIEW_DISTANCE={{ minecraft_environment_variables_view_distance }}
{% endif %}

{% if minecraft_environment_variables_pvp != '' %}
PVP={{ minecraft_environment_variables_pvp | to_json }}
{% endif %}

{% if minecraft_environment_variables_initial_enabled_packs != '' %}
INITIAL_ENABLED_PACKS={{ minecraft_environment_variables_initial_enabled_packs }}
{% endif %}

{{ minecraft_environment_variables_additional_variables }}
