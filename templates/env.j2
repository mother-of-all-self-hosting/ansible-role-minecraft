{# The port the server binds to inside the container. Without this, changing
   `minecraft_container_tcp_port` would only change the container-side end of the
   `-p` publish mapping, while the server itself kept listening on 25565.
   Declared before the additional variables so that an operator-supplied
   `SERVER_PORT` still wins (with `--env-file`, the last assignment applies). #}
SERVER_PORT={{ minecraft_container_tcp_port }}

